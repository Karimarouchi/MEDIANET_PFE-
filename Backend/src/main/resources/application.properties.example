spring.application.name=vulnix

# PostgreSQL Configuration
spring.datasource.url=jdbc:postgresql://localhost:5432/medianet_db
spring.datasource.username=postgres
spring.datasource.password=CHANGE_ME
spring.datasource.driver-class-name=org.postgresql.Driver

# JPA / Hibernate
spring.jpa.database-platform=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.sql.init.mode=always

# Server
server.port=8080

# Vulnix Scanner Config
vulnix.results.base-dir=C:/Users/user/Desktop/medianet/scan-results
vulnix.docker.image=medianet-kali-scanner:v3
vulnix.dc.cache.dir=C:/Users/user/.vulnix-dc-cache

# NVD API (https://nvd.nist.gov/developers/request-an-api-key)
nvd.api.key=${NVD_API_KEY:YOUR_NVD_API_KEY_HERE}

# Exploit-DB / CISA KEV
exploitdb.csv.local-path=C:/Users/user/Desktop/medianet/exploitdb-cache.csv
cisa.kev.local-path=C:/Users/user/Desktop/medianet/cisa-kev-cache.json

# Traduction automatique EN→FR via MyMemory
translation.enabled=true
translation.email=YOUR_EMAIL@example.com

# GitHub OAuth
github.client.id=${GITHUB_CLIENT_ID:YOUR_GITHUB_CLIENT_ID}
github.client.secret=${GITHUB_CLIENT_SECRET:YOUR_GITHUB_CLIENT_SECRET}
github.oauth.redirect-uri=http://localhost:8080/api/auth/github/callback
github.oauth.frontend-url=http://localhost:3000

# GitLab OAuth
gitlab.client.id=${GITLAB_CLIENT_ID:YOUR_GITLAB_CLIENT_ID}
gitlab.client.secret=${GITLAB_CLIENT_SECRET:YOUR_GITLAB_CLIENT_SECRET}
gitlab.oauth.redirect-uri=http://localhost:8080/api/auth/gitlab/callback

# Token encryption
token.encryption.key=

# GitHub Actions Integration
github.pat=${GITHUB_PAT:}
github.actions.owner=your-org
github.actions.repo=your-repo
github.actions.workflow-file=devsecops-pipeline.yml
github.actions.branch=main
github.actions.poll-interval-seconds=30
github.actions.token=${GITHUB_ACTIONS_TOKEN:}
github.actions.workflow=devsecops-pipeline.yml

# Bootstrap
app.first-user-is-admin=true
app.bootstrap.admin.enabled=true
app.bootstrap.admin.email=Admin@example.com
app.bootstrap.admin.login=Admin@example.com
app.bootstrap.admin.password=CHANGE_ME
app.bootstrap.admin.name=Admin

# JWT
jwt.secret=${JWT_SECRET:change-me-in-production}

# Error details
server.error.include-message=always
server.error.include-binding-errors=always

# Gemini AI Auto-Fix — set GEMINI_API_KEY in the environment (never commit a real key)
gemini.api.key=${GEMINI_API_KEY:}
gemini.api.url=https://generativelanguage.googleapis.com/v1beta/models/gemini-flash-latest:generateContent

# SSL Labs API v4
ssllabs.enabled=true
ssllabs.email=YOUR_EMAIL@example.com
ssllabs.firstName=PFE
ssllabs.lastName=Medianet
ssllabs.organization=Medianet

# Censys Platform API
censys.api.key=${CENSYS_API_KEY:YOUR_CENSYS_API_KEY_HERE}
censys.api.id=
censys.api.secret=
