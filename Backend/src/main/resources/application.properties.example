spring.application.name=vulnix

# Active le profil prod avec : SPRING_PROFILES_ACTIVE=prod
# (voir application-prod.properties)

# PostgreSQL
spring.datasource.url=${SPRING_DATASOURCE_URL:jdbc:postgresql://localhost:5432/medianet_db}
spring.datasource.username=${SPRING_DATASOURCE_USERNAME:postgres}
spring.datasource.password=${SPRING_DATASOURCE_PASSWORD:CHANGE_ME}
spring.datasource.driver-class-name=org.postgresql.Driver

# JPA / Hibernate
spring.jpa.database-platform=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.hibernate.ddl-auto=${JPA_DDL_AUTO:update}
spring.jpa.show-sql=${JPA_SHOW_SQL:false}
spring.sql.init.mode=${SQL_INIT_MODE:always}

# Server
server.port=${SERVER_PORT:8080}
server.error.include-message=${ERROR_INCLUDE_MESSAGE:on-param}
server.error.include-binding-errors=${ERROR_INCLUDE_BINDING:on-param}

# CORS — origines frontend autorisées (séparées par virgules)
# Dev : http://localhost:*
# Prod : https://ton-domaine.com
app.cors.allowed-origins=${APP_CORS_ALLOWED_ORIGINS:http://localhost:*}

# Scanner (chemins relatifs / Linux recommandés)
vulnix.results.base-dir=${VULNIX_RESULTS_BASE_DIR:./scan-results}
vulnix.docker.image=${VULNIX_DOCKER_IMAGE:medianet-kali-scanner:v3}
vulnix.dc.cache.dir=${VULNIX_DC_CACHE_DIR:${user.home}/.vulnix-dc-cache}

# NVD / caches
nvd.api.key=${NVD_API_KEY:}
exploitdb.csv.local-path=${EXPLOITDB_CSV_PATH:./exploitdb-cache.csv}
cisa.kev.local-path=${CISA_KEV_PATH:./cisa-kev-cache.json}

# Traduction
translation.enabled=true
translation.email=${TRANSLATION_EMAIL:}

# GitHub OAuth
github.client.id=${GITHUB_CLIENT_ID:}
github.client.secret=${GITHUB_CLIENT_SECRET:}
github.oauth.redirect-uri=${GITHUB_OAUTH_REDIRECT_URI:http://localhost:8080/api/auth/github/callback}
github.oauth.frontend-url=${GITHUB_OAUTH_FRONTEND_URL:http://localhost:3000}

# GitLab OAuth
gitlab.client.id=${GITLAB_CLIENT_ID:}
gitlab.client.secret=${GITLAB_CLIENT_SECRET:}
gitlab.oauth.redirect-uri=${GITLAB_OAUTH_REDIRECT_URI:http://localhost:8080/api/auth/gitlab/callback}

# Sécurité
token.encryption.key=${TOKEN_ENCRYPTION_KEY:}
jwt.secret=${JWT_SECRET:change-me-in-production-use-long-random-string}
jwt.access-token-minutes=${JWT_ACCESS_TOKEN_MINUTES:15}
jwt.refresh-token-days=${JWT_REFRESH_TOKEN_DAYS:7}
app.auth.cookie-secure=${COOKIE_SECURE:false}
app.auth.cookie-same-site=${COOKIE_SAME_SITE:Lax}
app.auth.login-rate-limit-per-minute=${LOGIN_RATE_LIMIT_PER_MINUTE:10}
app.auth.require-strong-jwt-secret=${REQUIRE_STRONG_JWT_SECRET:false}

# Bootstrap admin (désactiver en prod)
app.first-user-is-admin=${APP_FIRST_USER_IS_ADMIN:true}
app.bootstrap.admin.enabled=${APP_BOOTSTRAP_ADMIN_ENABLED:true}
app.bootstrap.admin.email=${APP_BOOTSTRAP_ADMIN_EMAIL:Admin@example.com}
app.bootstrap.admin.login=${APP_BOOTSTRAP_ADMIN_LOGIN:Admin@example.com}
app.bootstrap.admin.password=${APP_BOOTSTRAP_ADMIN_PASSWORD:CHANGE_ME}
app.bootstrap.admin.name=${APP_BOOTSTRAP_ADMIN_NAME:Admin}

# Gemini
gemini.api.key=${GEMINI_API_KEY:}
gemini.api.url=${GEMINI_API_URL:https://generativelanguage.googleapis.com/v1beta/models/gemini-flash-latest:generateContent}

# SSL Labs / Censys
ssllabs.enabled=${SSLLABS_ENABLED:true}
ssllabs.email=${SSLLABS_EMAIL:}
ssllabs.firstName=PFE
ssllabs.lastName=Medianet
ssllabs.organization=Medianet
censys.api.key=${CENSYS_API_KEY:}
censys.api.id=${CENSYS_API_ID:}
censys.api.secret=${CENSYS_API_SECRET:}
