# Allow-list: the root also holds node_modules, scan results, datasets, a venv... none of which belong in the image.
*
!Backend/pom.xml
!Backend/src
!ml/requirements-prod.txt
!ml/predict.py
!ml/train.py
!ml/artifacts
ml/artifacts/*.csv
!ml/supplychain
ml/supplychain/data
ml/supplychain/collect*.py
ml/supplychain/artifacts/v4_backup
ml/supplychain/artifacts/supplychain_model*.joblib
ml/supplychain/artifacts/preprocessing.joblib
ml/supplychain/artifacts/metrics_*
ml/supplychain/artifacts_pypi/preprocessing.joblib
ml/supplychain/artifacts_pypi/supplychain_model*.joblib
ml/supplychain/artifacts_pypi/metrics_*
ml/supplychain/*.log
ml/supplychain/*.err
ml/supplychain/eval
ml/supplychain/__pycache__
!ml/secrets
ml/secrets/results
ml/secrets/__pycache__
ml/secrets/evaluate.py
ml/secrets/big_eval.py
ml/secrets/compare_credsweeper.py
ml/secrets/export.py
ml/secrets/data.py
**/__pycache__
