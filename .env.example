# ═══ Copier vers .env et remplir avant docker compose up ═══
#   cp .env.example .env

# PostgreSQL
POSTGRES_DB=medianet_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Ports exposés sur l'hôte
FRONTEND_PORT=80
BACKEND_PORT=8080

# CORS — URL(s) publique(s) du frontend (virgules si plusieurs)
# Exemple HTTPS : https://vulnix.mondomaine.com
APP_CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# JWT — générer une longue chaîne aléatoire (≥ 32 car.) :
#   openssl rand -base64 64
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
LOGIN_RATE_LIMIT_PER_MINUTE=10

# Optionnel : chiffrement tokens OAuth
TOKEN_ENCRYPTION_KEY=

# OAuth GitHub (mettre les URLs HTTPS de prod dans la console GitHub)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8080/api/auth/github/callback
GITHUB_OAUTH_FRONTEND_URL=http://localhost

# OAuth GitLab
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_OAUTH_REDIRECT_URI=http://localhost:8080/api/auth/gitlab/callback

# APIs optionnelles
# Clé Gemini de l'APP (résumés CVE, journal, SSL) — ne pas partager avec le chat
GEMINI_API_KEY=
# Clé Gemini SYSTÈME du chatbot (si l'utilisateur n'a pas collé Gemini / ChatGPT / Grok / Claude dans Profil)
GEMINI_CHAT_API_KEY=
# Modèle cheap pour le chat (flash 2.0, pas flash-latest thinking)
GEMINI_CHAT_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent
NVD_API_KEY=
CENSYS_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
SSLLABS_EMAIL=
SSLLABS_ENABLED=true

# Bootstrap admin — laisser false en prod après le 1er compte
APP_BOOTSTRAP_ADMIN_ENABLED=false
APP_FIRST_USER_IS_ADMIN=true
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_PASSWORD=
APP_BOOTSTRAP_ADMIN_LOGIN=
APP_BOOTSTRAP_ADMIN_NAME=Admin

# Scanner Docker
VULNIX_DOCKER_IMAGE=medianet-kali-scanner:v3
# Chemin hôte partagé backend + conteneurs Kali (même path dans le conteneur)
VULNIX_HOST_DATA_DIR=/opt/vulnix

# Frontend : laisser vide si nginx proxy /api (recommandé)
REACT_APP_API_ORIGIN=
