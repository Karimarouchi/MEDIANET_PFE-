Hibernate: UPDATE scan_results SET status = 'RUNNING', worker_id = ?
WHERE id = (
    SELECT id FROM scan_results
    WHERE status = 'PENDING' AND scan_mode IN (?,?)
    ORDER BY started_at ASC
    LIMIT 1
    FOR UPDATE SKIP LOCKED
)
RETURNING id

