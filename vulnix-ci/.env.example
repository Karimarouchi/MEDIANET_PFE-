# Copier ce fichier en .env puis remplir. Le fichier .env ne se partage pas et ne va pas sur GitHub.

# Adresse où l'on ouvre Woodpecker dans le navigateur.
#   Local   : http://localhost:8000
#   Serveur : https://ci.ton-domaine.com
WOODPECKER_HOST=http://localhost:8000

# Local : 127.0.0.1 (seulement ce PC). Serveur derrière nginx : 127.0.0.1 aussi.
WOODPECKER_BIND=127.0.0.1
WOODPECKER_PORT=8000

# Ton identifiant GitHub (pas l'e-mail) : ce compte devient administrateur de Woodpecker.
WOODPECKER_ADMIN=

# Application OAuth GitHub (voir README, étape 1).
WOODPECKER_GITHUB_CLIENT=
WOODPECKER_GITHUB_SECRET=

# Secret partagé serveur <-> agent. Généré par setup.ps1 / setup.sh, ne pas réutiliser ailleurs.
WOODPECKER_AGENT_SECRET=

# Nombre de pipelines en même temps sur cette machine.
WOODPECKER_MAX_WORKFLOWS=2

# Signe les connexions agent <-> serveur (créé par setup).
WOODPECKER_GRPC_SECRET=

# Adresse publique appelée par GitHub à chaque git push. GitHub refuse localhost.
#   Local   : ton domaine (les appels n'arrivent pas tant que Woodpecker n'y est pas installé,
#             on lance alors la CI depuis Vulnix).
#   Serveur : la même adresse, que nginx envoie vers Woodpecker (voir README).
WOODPECKER_WEBHOOK_HOST=https://pfe.karimaoruchi.autolifeservices.com/ci

# Hôtes que Woodpecker peut appeler pour récupérer les pipelines fournis par Vulnix.
WOODPECKER_EXTENSIONS_ALLOWED_HOSTS=external,private

# Uptime Kuma (surveillance). Local et serveur : 127.0.0.1, derrière nginx si besoin d'y accéder de l'extérieur.
UPTIME_BIND=127.0.0.1
UPTIME_PORT=3001
